# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Migrations only (`npm run db:push`). Not read by the app.
#
# The Session pooler string from Project → Connect — port 5432, host ending in
# .pooler.supabase.com, user postgres.<project-ref>. NOT the direct connection
# (db.<ref>.supabase.co): Supabase made that IPv6-only, and a network with no
# IPv6 route cannot reach it, which fails as "Connection terminated
# unexpectedly". Percent-encode any @ # ? / : in the password.
SUPABASE_DB_URL=

# Resend Email Configuration (Optional)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@yourstore.com

# Admin Accounts
#
# Admins are Supabase Auth users allowlisted in public.admin_users, each with a
# role (owner | manager | fulfilment | read_only). There is no shared password
# in this file any more: ADMIN_PASSWORD_HASH and JWT_SECRET were read by the
# old single-credential login and are gone.
#
# Make the first owner with:
#   npm run admin:create -- owner@yourdomain.com <password> --name "Your Name"
# Everybody after that is invited from Admin -> Team, which emails them a link
# to set their own password.
#
# Where the store's own admin notifications are sent. Not a credential.
ADMIN_EMAIL=admin@yourdomain.com
#
# Optional. Project Settings -> API -> JWT Secret. When set, an admin session is
# verified locally instead of costing a round trip to the auth server on every
# request; without it everything still works, just more slowly. Leave unset on a
# project using asymmetric signing keys.
SUPABASE_JWT_SECRET=

# Public Bank Details for Manual Transfer Checkout
NEXT_PUBLIC_BANK_NAME=Your Bank Name
NEXT_PUBLIC_ACCOUNT_NAME=Your Account Name
NEXT_PUBLIC_ACCOUNT_NUMBER=0123456789
NEXT_PUBLIC_SORT_CODE=123

# SMS Notifications via Termii (optional)
# Leave both unset and SMS is simply reported as "not configured" — the admin UI
# says so rather than claiming the customer was texted. Set both and SMS starts
# sending with no code change. Sender ID must be one Termii has approved for
# your account.
TERMII_API_KEY=
TERMII_SENDER_ID=

# Gmail SMTP Configuration for Order Notifications
# EMAIL_PASS must be a Gmail App Password, not the account password.
# Port 587 uses STARTTLS (EMAIL_SECURE unset/false). Many home and office
# networks block outbound 587 and 25 — if sends time out locally, switch to
# port 465 with EMAIL_SECURE=true, which is usually open.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=noreply@yourstore.com

# Cloudinary Configuration for Image/Receipt Uploads
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Store Owner Email (For notifications)
STORE_OWNER_EMAIL=your_email@gmail.com

# Online payment via Paystack (optional)
#
# Leave PAYSTACK_SECRET_KEY unset and checkout offers bank transfer only, the
# way it always has — nothing breaks, the option simply is not shown.
#
# Both variables are needed to switch it on. The secret key is what actually
# authorises anything and never reaches the browser; the NEXT_PUBLIC flag only
# decides whether the "Pay now" option is offered, and the server checks the
# real key independently — so a wrong flag produces a clean "not available"
# rather than a broken charge.
#
# Webhook: add https://<your-domain>/api/webhooks/paystack in the Paystack
# dashboard and subscribe to charge.success. It is what confirms an order when
# the customer closes the tab before coming back.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_ENABLED=false
